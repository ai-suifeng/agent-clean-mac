          "explain": "登录信息、插件、内置智能体和配置。" },
        { "id": "zc-sessions", "label": "旧会话与产物", "paths": ["~/.zcode/cli/agents/*", "~/.zcode/cli/rollout/*", "~/.zcode/cli/artifacts/*"], "risk": "history", "action": "age-filter", "ageUnit": "entry",
          "explain": "每个会话的工作目录、运行记录和生成的产物，单个会话可能有几百 MB。" },
        { "id": "zc-checkpoints", "label": "代码检查点", "paths": ["~/.zcode/v2/checkpoints/*"], "risk": "history", "action": "age-filter", "ageUnit": "entry",
          "explain": "用于回退代码的快照。30 天前的基本不会再用到。" },
        { "id": "zc-db", "label": "会话数据库", "paths": ["~/.zcode/cli/db/db.sqlite"], "risk": "compact", "action": "vacuum",
          "explain": "ZCode 的会话数据库。不能删除，退出后可以压缩。" },
