    {
      "id": "zcode",
      "name": "ZCode",
      "color": "#22D3EE",
      "detect": { "paths": ["~/.zcode", "~/Library/Application Support/ZCode", "~/Library/Application Support/ai.z.zcode"], "apps": ["ZCode.app"], "processes": ["ZCode", "zcode"] },
      "orphanWhenAppMissing": true,
      "rules": [
        { "id": "zc-protected", "label": "登录信息、插件与配置", "risk": "protected", "action": "none",
