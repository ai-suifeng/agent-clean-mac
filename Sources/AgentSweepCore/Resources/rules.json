        { "id": "km-cache", "label": "缓存、日志与遥测", "risk": "safe", "action": "trash",
          "paths": ["~/.kimi/logs", "~/.kimi/prompt-cache", "~/.kimi/telemetry", "~/.kimi/config.json.bak",
                    "~/.kimi-code/cache/query-store", "~/.kimi-code/logs", "~/.kimi-code/telemetry", "~/.kimi-code/updates", "~/.kimi-code/migration-errors.log", "~/.kimi-code/config.toml.bak", "~/.kimi-code/config.toml.*.bak",
                    "~/.kimi-webbridge/logs", "~/Library/Application Support/kimi-desktop/daimon-share/daimon/logs", "~/Library/Caches/kimi-code", "~/Library/Application Support/kimi-code-app/{Cache,Code Cache,GPUCache,GraphiteDawnCache,DawnGraphiteCache,DawnWebGPUCache,Crashpad,logs}"],
          "explain": "查询缓存、日志、更新包和桌面版的内核缓存，删除后会自动重建。" }
      ]
    },
    {
      "id": "minimax",
      "name": "MiniMax Code",
      "color": "#F43F5E",
      "detect": { "paths": ["~/.minimax", "~/.minimax-agent-cn", "~/Library/Application Support/MiniMax"], "apps": ["MiniMax Code.app"], "processes": ["MiniMax Code", "MiniMax"] },
      "orphanWhenAppMissing": true,
      "rules": [
        { "id": "mm-protected", "label": "智能体、技能与配置", "risk": "protected", "action": "none",
