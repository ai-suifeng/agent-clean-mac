          "explain": "运行缓存、观测日志和内核缓存，删除后会自动重建。" },
        { "id": "mm-orphan", "label": "MiniMax Code 全部残留数据", "paths": ["~/.minimax", "~/.minimax-agent-cn", "~/Library/Application Support/MiniMax"], "risk": "orphan", "action": "trash", "onlyWhen": "appMissing",
          "explain": "没有找到 MiniMax Code.app，这些是卸载后留下的数据。" }
