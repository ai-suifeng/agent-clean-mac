        { "id": "mm-sessions", "label": "旧会话", "paths": ["~/.minimax/v2/sessions/*", "~/.minimax-agent-cn/projects/*"], "risk": "history", "action": "age-filter", "ageUnit": "entry",
          "explain": "MiniMax Code 的会话记录。" },
        { "id": "mm-tasks", "label": "后台任务记录", "paths": ["~/.minimax/background-tasks/*"], "risk": "history", "action": "age-filter", "ageUnit": "entry",
          "explain": "后台任务的运行记录。" },
        { "id": "mm-db", "label": "运行状态数据库", "paths": ["~/.minimax/v2/sqlite/runtime-state.sqlite"], "risk": "compact", "action": "vacuum",
          "explain": "MiniMax Code 的运行状态数据库。不能删除，退出后可以压缩。" },
        { "id": "mm-db-backups", "label": "数据库旧备份", "paths": ["~/.minimax/v2/sqlite/backups/*"], "risk": "safe", "action": "age-filter", "ageUnit": "entry",
